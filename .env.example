# Omnicampus Automation Configuration

# Target browser: brave | chrome | edge | chromium
BROWSER=brave

# Chrome DevTools Protocol (CDP) port and host
CDP_PORT=9222
CDP_HOST=127.0.0.1

# Omnicampus assignment configuration (defaults to Course 170 / Assignment 1038)
OMNICAMPUS_COURSE_ID=170
OMNICAMPUS_ASSIGNMENT_ID=1038
OMNICAMPUS_BASE_URL=https://edu.omnicamp.us

# Optional: Account Name for automated leaderboard rank & percentile tracking
# OMNICAMPUS_ACCOUNT_NAME=your_account_name

# Optional: Custom directory for cross-process queue lock (defaults to OS temp directory)
# OMNICAMPUS_QUEUE_DIR=
